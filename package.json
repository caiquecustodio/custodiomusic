{
  "name": "custodio-music-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "expo": "~58.0.17",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.14",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "expo-image": "~58.0.17",
    "expo-image-manipulator": "~58.0.15",
    "expo-keep-awake": "~58.0.3",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-media-library": "~58.0.11",
    "expo-router": "~58.0.25",
    "expo-sharing": "~58.0.20",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-screens": "^4.30.0",
    "react-native-svg": "^15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "apk:debug": "node scripts/build-apk.mjs",
    "apk:check": "node scripts/build-apk.mjs check",
    "apk:stop": "node scripts/build-apk.mjs stop",
    "test:apk": "node --test tests/apk-build.test.mjs",
    "postinstall": "node scripts/patch-expo-audio.mjs"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-audio"
        ]
      }
    }
  }
}
